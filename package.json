{
  "name": "budget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "financeExtension": {
    "id": "budget",
    "displayName": "Budget",
    "version": "0.1.0",
    "description": "Budget extension",
    "themeColor": "#6366F1",
    "activationEvents": ["onView:budget"],
    "contributions": {
      "views": [{ "id": "budget", "name": "Budget", "icon": "assets/icon.svg" }],
      "commands": [{ "id": "budget.hello", "title": "Budget: Hello" }],
      "navigation": [{ "id": "budget-main", "label": "Budget", "command": "budget.hello", "group": "Budget" }],
      "configuration": [
        { "key": "budget.themeColor", "type": "string", "label": "Accent color for icons, topbar actions, and in-view highlights (hex).", "default": "#6366F1", "pattern": "^#[0-9A-Fa-f]{6}$", "formatHint": "#RRGGBB", "placeholder": "#6366F1" }
      ],
      "allowedCommands": ["budget.hello"],
      "allowedUiEvents": []
    },
    "main": "src/main.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "node D:/finance_flow_ai/scripts/sdk/cli.mjs build ."
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "lit": "^3.1.0"
  }
}
